# ==============================================================================
# NoteRecall - Application Environment Configuration
# ==============================================================================

APP_NAME=NoteRecall
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=noterecall-prototype-secret-key-32chars

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database
DATABASE_URL=sqlite:///./data/noterecall.db

# LLM Provider Configuration (NVIDIA API / OpenAI-compatible)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your_nvidia_api_key_here
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Spaced Repetition (SM-2 Defaults)
SM2_DEFAULT_EASE_FACTOR=2.5
SM2_MIN_EASE_FACTOR=1.3
