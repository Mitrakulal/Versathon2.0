# ==============================================================================
# NoteRecall - Application Environment Configuration
# ==============================================================================

# Application
APP_NAME=NoteRecall
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-super-secret-key-32chars

# CORS (Comma-separated list of origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database
DATABASE_URL=sqlite:///./data/noterecall.db
# For PostgreSQL: postgresql://user:password@localhost:5432/noterecall

# Vector Store
VECTOR_STORE_TYPE=chroma # chroma | faiss
VECTOR_STORE_PATH=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2 # sentence-transformers local model or provider model

# LLM Provider Configuration
# Supported providers: openai, openrouter, ollama, local
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Background Worker Settings
ASYNC_WORKER_CONCURRENCY=2

# Spaced Repetition (SM-2 Defaults)
SM2_DEFAULT_EASE_FACTOR=2.5
SM2_MIN_EASE_FACTOR=1.3

# Frontend Variables (used by Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
